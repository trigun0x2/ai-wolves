# Copy to .env and fill in the keys for the providers you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Server port (UI served here; OBS browser source points at http://localhost:3000)
PORT=3000

# --- Operator auth (recommended before exposing publicly) ---
# When set, host actions (start/replay/queue-removal/speed) require this token.
# Open the dashboard with ?op=THE_TOKEN to unlock it. Unset = open (local dev).
# OPERATOR_TOKEN=change-me-to-a-long-random-string

# --- Persistence (optional) ---
# Global leaderboard store. If REDIS_URL is set, the leaderboard lives in Redis
# (recommended in production, e.g. Upstash on Fly.io); otherwise it's a JSON file.
# REDIS_URL=redis://default:password@host:6379

# Where the JSON-file leaderboard + transcripts live (point at a mounted volume
# in production). Defaults to ./data and ./transcripts.
# DATA_DIR=/data
# TRANSCRIPTS_DIR=/data/transcripts
